# Copy to .env.local and fill in. Never commit real secrets.

# NextAuth
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=

# Spotify OAuth app
# Spotify dashboard → Redirect URI: http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dev-only passwordless login. Keep unset/false anywhere non-local.
MOCK_LOGIN=false
