# Copy to .env.local and fill in. Never commit real secrets.

# App
APP_URL=http://127.0.0.1:3000
# WebSocket dev server (removed once realtime moves to tRPC v11 SSE — see DIS-54)
WS_URL=ws://127.0.0.1:3001

# NextAuth
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=

# Spotify OAuth app
# Spotify dashboard → Redirect URI: http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dev-only passwordless login. Keep unset/false anywhere non-local.
MOCK_LOGIN=false
